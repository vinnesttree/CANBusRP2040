/ {
	fake_pwm: fake_pwm {
		compatible = "zephyr,fake-pwm";
		status = "okay";
		#pwm-cells = <2>;
		/* One timer cycle per nanosecond */
		frequency = <1000000000>;
	};

	zephyr,user {
		pwms = <&fake_pwm 3 5000000>;
	};
};
