 *
 * Two USB serial ports on any board with a USB device controller.
 */

&zephyr_udc0 {
	slcan_cdc_acm: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "slcan";
	};

	phoenix6_uart: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Phoenix 6 bridge";
	};
};
