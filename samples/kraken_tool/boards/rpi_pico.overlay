 *
 * PWM output for driving a Kraken on GP15 (PWM slice 7, channel B).
 * Connect GP15 to the motor's CAN-H (yellow) wire and GND to CAN-L (green)
 * of a motor that is NOT connected to the CAN bus.
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

&pinctrl {
	kraken_pwm_default: kraken_pwm_default {
		group1 {
			pinmux = <PWM_7B_P15>;
		};
	};
};

&pwm {
	status = "okay";
	pinctrl-0 = <&kraken_pwm_default>;
	pinctrl-names = "default";
};

/ {
	zephyr,user {
		/* Channel 15 = slice 7, channel B */
		pwms = <&pwm 15 PWM_MSEC(5) PWM_POLARITY_NORMAL>;
	};
};
